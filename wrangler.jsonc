{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aurabella",
  "compatibility_date": "2026-07-08",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npm --prefix client run build"
  },
  "assets": {
    "directory": "client/dist"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
